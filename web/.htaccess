# Lindungi file konfigurasi & data
<FilesMatch "^(config\.php|config\.sample\.php)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/absensi-sk/data/
Options -Indexes
DirectoryIndex index.html
