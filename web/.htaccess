# Lindungi file konfigurasi & data
<FilesMatch "^(config\.php|config\.sample\.php|error_log)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
RedirectMatch 403 ^/absensi-sk/data/
Options -Indexes

# Pengaman tambahan dari browser
<IfModule mod_headers.c>
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "same-origin"
  Header always set Permissions-Policy "geolocation=(self), camera=(), microphone=()"
</IfModule>
DirectoryIndex index.html
